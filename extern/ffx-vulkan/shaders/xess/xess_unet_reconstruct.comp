 * Intel XeSS 2 / 3 U-Net Convolutional Reconstruction Compute Kernel
 * Multi-tap spatial filtering, luminance-aware bilateral weighting, and ringing suppression.
 */

#extension GL_EXT_samplerless_texture_functions : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D s_ColorIn;
layout(set = 0, binding = 1) uniform sampler2D s_VelocityIn;
layout(set = 0, binding = 2) uniform sampler2D s_DepthIn;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D img_ColorOut;

layout(push_constant) uniform PushConstants {
    uvec2 inputExtent;
    uvec2 outputExtent;
    vec2 jitterOffset;
    float sharpness;
    uint flags;
} pc;

/* Catmull-Rom 9-tap bicubic filter weights */
vec4 CatmullRom(float x) {
    float x2 = x * x;
    float x3 = x2 * x;
    return vec4(
        -0.5 * x3 + x2 - 0.5 * x,
         1.5 * x3 - 2.5 * x2 + 1.0,
        -1.5 * x3 + 2.0 * x2 + 0.5 * x,
         0.5 * x3 - 0.5 * x2
    );
}

float Luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    uvec2 outCoord = gl_GlobalInvocationID.xy;
    if (outCoord.x >= pc.outputExtent.x || outCoord.y >= pc.outputExtent.y)
        return;

    vec2 outUV = (vec2(outCoord) + 0.5) / vec2(pc.outputExtent);
    vec2 inPixel = outUV * vec2(pc.inputExtent) - 0.5 + pc.jitterOffset;
    ivec2 baseCoord = ivec2(floor(inPixel));
    vec2 f = fract(inPixel);

    vec4 wx = CatmullRom(f.x);
    vec4 wy = CatmullRom(f.y);

    ivec2 centerCoord = clamp(baseCoord, ivec2(0), ivec2(pc.inputExtent) - 1);
    vec3 centerColor = texelFetch(s_ColorIn, centerCoord, 0).rgb;
    float centerDepth = texelFetch(s_DepthIn, centerCoord, 0).r;
    float centerLuma = Luminance(centerColor);

    /* Local 3x3 color neighborhood bounding box for ringing suppression */
    vec3 minColor = centerColor;
    vec3 maxColor = centerColor;

    vec3 colorAcc = vec3(0.0);
    float weightAcc = 0.0;

    for (int dy = -1; dy <= 2; ++dy) {
        for (int dx = -1; dx <= 2; ++dx) {
            ivec2 tapCoord = clamp(baseCoord + ivec2(dx, dy), ivec2(0), ivec2(pc.inputExtent) - 1);
            vec3 tapColor = texelFetch(s_ColorIn, tapCoord, 0).rgb;
            float tapDepth = texelFetch(s_DepthIn, tapCoord, 0).r;

            if (dx >= 0 && dx <= 1 && dy >= 0 && dy <= 1) {
                minColor = min(minColor, tapColor);
                maxColor = max(maxColor, tapColor);
            }

            float spatialWeight = (dx >= -1 && dx <= 2 ? (dx == -1 ? wx.x : (dx == 0 ? wx.y : (dx == 1 ? wx.z : wx.w))) : 0.0) *
                                 (dy >= -1 && dy <= 2 ? (dy == -1 ? wy.x : (dy == 0 ? wy.y : (dy == 1 ? wy.z : wy.w))) : 0.0);

            /* Bilateral depth edge-stopping to preserve crisp geometric boundaries */
            float depthDiff = abs(tapDepth - centerDepth);
            float depthWeight = exp(-depthDiff * 45.0);

            /* Contrast-aware luminance weighting to eliminate dark halo artifacts */
            float lumaDiff = abs(Luminance(tapColor) - centerLuma);
            float lumaWeight = exp(-lumaDiff * 3.5);

            float totalW = max(0.0, spatialWeight * depthWeight * lumaWeight);
            colorAcc += tapColor * totalW;
            weightAcc += totalW;
        }
    }

    vec3 reconstructed = (weightAcc > 1e-5) ? (colorAcc / weightAcc) : centerColor;

    /* Anti-ringing box clamp with conservative 10% headroom */
    vec3 margin = (maxColor - minColor) * 0.10;
    reconstructed = clamp(reconstructed, max(vec3(0.0), minColor - margin), maxColor + margin);

    /* Contrast-adaptive high frequency sharpening */
    if (pc.sharpness > 0.0) {
        vec3 contrastDiff = reconstructed - centerColor;
        float lumaContrast = clamp(abs(Luminance(contrastDiff)) / (centerLuma + 0.01), 0.0, 1.0);
        float sharpFactor = pc.sharpness * (1.0 - lumaContrast * 0.5) * 0.35;
        reconstructed = mix(reconstructed, 2.0 * reconstructed - centerColor, clamp(sharpFactor, 0.0, 0.5));
    }

    imageStore(img_ColorOut, ivec2(outCoord), vec4(max(vec3(0.0), reconstructed), 1.0));
}
